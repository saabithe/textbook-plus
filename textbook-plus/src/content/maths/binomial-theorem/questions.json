  {"id":"bt-q04","type":"mcq","difficulty":"medium","question":"(1+x)ⁿ = nC0 + nC1x + nC2x² + … — what is the sum of all binomial coefficients nC0 + nC1 + … + nCn?","options":["n","2n","2ⁿ","n²"],"answer":"2ⁿ"},
